APP_NAME="Laptop Registratie"
APP_ENV=production
# Genereer met: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://laptops.example.be
APP_TIMEZONE=Europe/Brussels
APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl

# Eén gedeelde login voor de hele applicatie.
AUTH_USERNAME=admin
AUTH_PASSWORD=

# MySQL/MariaDB-database (in Plesk: Databases → Database toevoegen)
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=laptops
DB_USERNAME=laptops
DB_PASSWORD=

# Sessies: 8 uur geldig, cookie alleen over HTTPS.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

LOG_CHANNEL=daily
LOG_LEVEL=warning

MAIL_MAILER=log
